{
  "scenario": "medium",
  "events": 68,
  "campaign_notables": 8,
  "noise_notables": 60,
  "true_positive_notables": 8,
  "benign_positive_notables": 60,
  "sourcetype": "stash",
  "source": "per-event search_name",
  "stash_schema": "es8-direct-notable-kv-v4",
  "notable_model": "non-rba-direct-event-risk-object",
